<!DOCTYPE html>
<html lang="pl">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>VAD Monitor — Dystrybutorzy/Broker/Reseller (CH)</title>
<style>
  body { font-family: -apple-system, Helvetica, Arial, sans-serif; margin: 0; background: #f4f4f5; color: #1a1a2e; }
  header { background: #1a1a2e; color: #fff; padding: 16px 24px; }
  header h1 { margin: 0; font-size: 20px; }
  header p { margin: 4px 0 0; font-size: 13px; color: #c0c0d0; }
  .controls { display: flex; flex-wrap: wrap; gap: 8px; padding: 16px 24px; background: #fff; border-bottom: 1px solid #e0e0e0; }
  .controls input { padding: 6px 10px; border: 1px solid #ccc; border-radius: 4px; font-size: 13px; }
  table { width: 100%; border-collapse: collapse; background: #fff; }
  th, td { text-align: left; padding: 8px 12px; font-size: 13px; border-bottom: 1px solid #eee; vertical-align: top; }
  th { background: #f9f9fb; position: sticky; top: 0; cursor: pointer; }
  a { color: #1a1a2e; }
  .wrap { max-width: 1100px; margin: 0 auto; padding-bottom: 40px; }
  .back { font-size: 13px; }
  tr.starred { background: #fff8e1; }
  .star-cell { text-align: center; }
  .star-cell input { width: 16px; height: 16px; cursor: pointer; }
</style>
</head>
<body>
<header><div class="wrap">
<h1>Dystrybutorzy / Broker / Reseller — przemysł techniczny, maszyny, wyposażenie statków (CH)</h1>
<p>Ostatnia aktualizacja: {{ run_date }} · {{ records|length }} firm w archiwum · <a class="back" href="index.html" style="color:#c0c0d0;">← główny dashboard</a></p>
</div></header>

<div class="wrap">
<div class="controls">
  <input id="q" type="text" placeholder="Szukaj słowa kluczowego...">
  <select id="tier"><option value="">Wszystkie tiery</option><option value="Tier 1">Tier 1</option><option value="Tier 2">Tier 2</option><option value="Tier 1 + Tier 2">Tier 1 + Tier 2</option></select>
  <select id="activityCategory"><option value="">Wszystkie kategorie działalności</option>{% for c in categories %}<option value="{{ c }}">{{ c }}</option>{% endfor %}</select>
  <label style="font-size:13px;"><input type="checkbox" id="onlyStarred"> tylko oznaczone ★</label>
</div>

<table id="tbl">
<thead><tr>
<th>★</th>
<th data-k="title">Firma</th>
<th>WWW</th>
<th data-k="buyer">Forma prawna / miejscowość</th>
<th data-k="tier">Tier</th>
<th data-k="activityCategory">Kategoria działalności</th>
<th data-k="date_first_seen">Wykryto</th>
<th>Uzasadnienie</th>
</tr></thead>
<tbody>
{% for r in records %}
<tr data-tier="{{ r.commodity_tier or '' }}" data-activity-category="{{ r.activity_category or '' }}"
    data-star-id="{{ r.dedup_key }}" data-text="{{ (r.title ~ ' ' ~ (r.buyer or '') ~ ' ' ~ (r.keywords_matched or ''))|lower }}">
  <td class="star-cell"><input type="checkbox" class="star-check"></td>
  <td><a href="{{ r.url }}" target="_blank">{{ r.title }}</a></td>
  <td>{% if r.website %}<a href="{{ r.website }}" target="_blank">🔗</a>{% endif %}</td>
  <td>{{ r.buyer or "" }}</td>
  <td>{{ r.commodity_tier or "" }}</td>
  <td>{{ r.activity_category or "" }}</td>
  <td>{{ r.date_first_seen }}</td>
  <td>{{ r.reason }}</td>
</tr>
{% endfor %}
</tbody>
</table>
</div>

<script>
const q = document.getElementById('q'), tier = document.getElementById('tier'),
      activityCategory = document.getElementById('activityCategory'),
      onlyStarred = document.getElementById('onlyStarred');
const STAR_KEY = 'vadMonitorStarredDistributors';
function loadStarred() {
  try { return JSON.parse(localStorage.getItem(STAR_KEY) || '{}'); } catch (e) { return {}; }
}
function saveStarred(obj) { localStorage.setItem(STAR_KEY, JSON.stringify(obj)); }
const starred = loadStarred();
document.querySelectorAll('#tbl tbody tr').forEach(row => {
  const id = row.dataset.starId;
  const box = row.querySelector('.star-check');
  if (starred[id]) { box.checked = true; row.classList.add('starred'); }
  box.addEventListener('change', () => {
    if (box.checked) { starred[id] = true; row.classList.add('starred'); }
    else { delete starred[id]; row.classList.remove('starred'); }
    saveStarred(starred);
    applyFilters();
  });
});
function applyFilters() {
  const term = q.value.toLowerCase();
  document.querySelectorAll('#tbl tbody tr').forEach(row => {
    const okText = !term || row.dataset.text.includes(term);
    const okTier = !tier.value || row.dataset.tier === tier.value;
    const okActivityCategory = !activityCategory.value || row.dataset.activityCategory === activityCategory.value;
    const okStarred = !onlyStarred.checked || !!starred[row.dataset.starId];
    row.style.display = (okText && okTier && okActivityCategory && okStarred) ? "" : "none";
  });
}
[q, tier, activityCategory, onlyStarred].forEach(el => el.addEventListener('input', applyFilters));
document.querySelectorAll('th[data-k]').forEach(th => th.addEventListener('click', () => {
  const key = th.dataset.k;
  const tbody = document.querySelector('#tbl tbody');
  const rows = Array.from(tbody.querySelectorAll('tr'));
  const idx = Array.from(th.parentNode.children).indexOf(th);
  const asc = th.dataset.asc !== "true";
  rows.sort((a, b) => a.children[idx].innerText.localeCompare(b.children[idx].innerText) * (asc ? 1 : -1));
  th.dataset.asc = asc;
  rows.forEach(r => tbody.appendChild(r));
}));
</script>
</body>
</html>
