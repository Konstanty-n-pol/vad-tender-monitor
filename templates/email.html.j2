<!DOCTYPE html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"></head>
<body style="margin:0;padding:0;background:#f4f4f5;font-family:-apple-system,Helvetica,Arial,sans-serif;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f4f5;padding:16px 0;">
<tr><td align="center">
<table role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width:600px;width:100%;background:#ffffff;border-radius:8px;overflow:hidden;">

<tr><td style="background:#1a1a2e;padding:20px 24px;">
<h1 style="margin:0;color:#fff;font-size:18px;">VAD Monitor — {{ run_date }}</h1>
<p style="margin:6px 0 0;color:#c0c0d0;font-size:13px;">
🔴 {{ tenders|length }} tenders &nbsp;·&nbsp; 🟡 {{ companies|length }} companies/investments &nbsp;·&nbsp; ⚪ {{ news|length }} news
</p>
</td></tr>

{% if not tenders and not companies and not news %}
<tr><td style="padding:32px 24px;text-align:center;color:#666;font-size:14px;">
Quiet week — no new matches above the relevance threshold.
</td></tr>
{% endif %}

{% macro flag(country) -%}
{{ country_name(country) }} —
{%- endmacro %}

{% if tenders %}
<tr><td style="padding:20px 24px 4px;">
<h2 style="margin:0 0 8px;font-size:15px;color:#1a1a2e;border-bottom:2px solid #e63946;padding-bottom:6px;">🔴 Tenders ({{ tenders|length }})</h2>
{% for r in tenders %}
<div style="padding:10px 0;border-bottom:1px solid #eee;">
<a href="{{ r.url }}" style="font-size:14px;font-weight:600;color:#1a1a2e;text-decoration:none;">{{ flag(r.country) }} {{ r.display_title }}</a>{% if r.display_title != r.title %}<div style="font-size:11px;color:#999;margin-top:2px;">{{ r.title }}</div>{% endif %}
<div style="font-size:12px;color:#888;margin-top:3px;">{{ r.source }}{% if r.deadline %} · deadline: {{ r.deadline }}{% endif %}{% if r.value_estimate %} · value: {{ r.value_estimate }}{% endif %}</div>
<div style="font-size:12px;color:#555;margin-top:2px;">{{ r.reason }}</div>
</div>
{% endfor %}
</td></tr>
{% endif %}

{% if companies %}
<tr><td style="padding:20px 24px 4px;">
<h2 style="margin:0 0 8px;font-size:15px;color:#1a1a2e;border-bottom:2px solid #f4a300;padding-bottom:6px;">🟡 Companies / investments ({{ companies|length }})</h2>
{% for r in companies %}
<div style="padding:10px 0;border-bottom:1px solid #eee;">
<a href="{{ r.url }}" style="font-size:14px;font-weight:600;color:#1a1a2e;text-decoration:none;">{{ flag(r.country) }} {{ r.display_title }}</a>{% if r.display_title != r.title %}<div style="font-size:11px;color:#999;margin-top:2px;">{{ r.title }}</div>{% endif %}
{% if r.website %} <a href="{{ r.website }}" style="font-size:12px;color:#888;">(www)</a>{% endif %}
<div style="font-size:12px;color:#888;margin-top:3px;">{{ r.source }}{% if r.commodity_tier %} · {{ r.commodity_tier }}{% endif %}</div>
<div style="font-size:12px;color:#555;margin-top:2px;">{{ r.reason }}</div>
</div>
{% endfor %}
</td></tr>
{% endif %}

{% if news %}
<tr><td style="padding:20px 24px 4px;">
<h2 style="margin:0 0 8px;font-size:15px;color:#1a1a2e;border-bottom:2px solid #999;padding-bottom:6px;">⚪ News ({{ news|length }})</h2>
{% for r in news %}
<div style="padding:6px 0;font-size:13px;">
<a href="{{ r.url }}" style="color:#1a1a2e;text-decoration:none;">{{ flag(r.country) }} {{ r.display_title }}</a>{% if r.display_title != r.title %}<div style="font-size:11px;color:#999;margin-top:2px;">{{ r.title }}</div>{% endif %}
<span style="color:#999;"> — {{ r.source }}</span>
</div>
{% endfor %}
</td></tr>
{% endif %}

<tr><td style="padding:20px 24px;background:#f9f9fb;text-align:center;">
<a href="{{ dashboard_url }}" style="font-size:13px;color:#1a1a2e;">Full dashboard →</a>
</td></tr>

</table>
</td></tr>
</table>
</body>
</html>
