<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>VAD Monitor Dashboard</title>
<style>
  body { font-family: -apple-system, Helvetica, Arial, sans-serif; margin: 0; background: #f4f4f5; color: #1a1a2e; }
  header { background: #1a1a2e; color: #fff; padding: 16px 24px; }
  header h1 { margin: 0; font-size: 20px; }
  header p { margin: 4px 0 0; font-size: 13px; color: #c0c0d0; }
  .controls { display: flex; flex-wrap: wrap; gap: 8px; padding: 16px 24px; background: #fff; border-bottom: 1px solid #e0e0e0; }
  .controls input, .controls select { padding: 6px 10px; border: 1px solid #ccc; border-radius: 4px; font-size: 13px; }
  table { width: 100%; border-collapse: collapse; background: #fff; }
  th, td { text-align: left; padding: 8px 12px; font-size: 13px; border-bottom: 1px solid #eee; vertical-align: top; }
  th { background: #f9f9fb; position: sticky; top: 0; cursor: pointer; }
  tr.expired { opacity: 0.45; }
  .cat-tender { border-left: 4px solid #e63946; }
  .cat-company { border-left: 4px solid #f4a300; }
  .cat-news { border-left: 4px solid #999; }
  a { color: #1a1a2e; }
  .wrap { max-width: 1100px; margin: 0 auto; padding-bottom: 40px; }
  .days { font-variant-numeric: tabular-nums; color: #666; }
  tr.starred { background: #fff8e1; }
  .star-cell { text-align: center; }
  .star-cell input { width: 16px; height: 16px; cursor: pointer; }
</style>
</head>
<body>
<header><div class="wrap">
<h1>VAD Monitor — GIS/MV-HV spare parts &amp; Starlink accessories (DACH/CEE/UA)</h1>
<p>Last updated: {{ run_date }} · {{ records|length }} items in archive · <a href="distributors.html" style="color:#c0c0d0;">Distributors/Brokers/Resellers (CH) →</a></p>
</div></header>

<div class="wrap">
<div class="controls">
  <input id="q" type="text" placeholder="Search keyword...">
  <select id="country"><option value="">All countries</option>{% for c in countries %}<option value="{{ c }}">{{ country_name(c) }}</option>{% endfor %}</select>
  <select id="category"><option value="">All types</option><option value="tender">🔴 Tenders</option><option value="company">🟡 Companies</option><option value="news">⚪ News</option></select>
  <select id="source"><option value="">All sources</option>{% for s in sources %}<option value="{{ s }}">{{ s }}</option>{% endfor %}</select>
  <select id="tier"><option value="">All tiers</option><option value="Tier 1">Tier 1</option><option value="Tier 2">Tier 2</option><option value="Tier 1 + Tier 2">Tier 1 + Tier 2</option></select>
  <select id="activityCategory"><option value="">All activity categories</option>{% for c in categories %}<option value="{{ c }}">{{ c }}</option>{% endfor %}</select>
  <label style="font-size:13px;"><input type="checkbox" id="hideExpired"> hide expired</label>
  <label style="font-size:13px;"><input type="checkbox" id="onlyStarred"> starred only ★</label>
</div>

<table id="tbl">
<thead><tr>
<th>★</th>
<th data-k="category">Type</th>
<th data-k="country">Country</th>
<th data-k="title">Title</th>
<th>WWW</th>
<th data-k="buyer">Buyer</th>
<th data-k="tier">Tier</th>
<th data-k="activityCategory">Activity category</th>
<th data-k="source">Source</th>
<th data-k="date_first_seen">First seen</th>
<th data-k="days_since">Days since</th>
<th data-k="deadline">Deadline</th>
<th>Why it matched</th>
</tr></thead>
<tbody>
{% for r in records %}
<tr class="cat-{{ r.category }}{% if r.expired %} expired{% endif %}"
    data-country="{{ r.country }}" data-category="{{ r.category }}" data-source="{{ r.source }}"
    data-tier="{{ r.commodity_tier or '' }}" data-activity-category="{{ r.activity_category or '' }}"
    data-star-id="{{ r.dedup_key }}"
    data-expired="{{ r.expired }}" data-text="{{ (r.title ~ ' ' ~ (r.title_en or '') ~ ' ' ~ (r.reason or '') ~ ' ' ~ (r.buyer or '') ~ ' ' ~ (r.keywords_matched or ''))|lower }}">
  <td class="star-cell"><input type="checkbox" class="star-check"></td>
  <td>{{ {"tender": "🔴", "company": "🟡", "news": "⚪"}.get(r.category, "") }}</td>
  <td>{{ country_name(r.country) }}</td>
  <td><a href="{{ r.url }}" target="_blank">{{ r.display_title }}</a>{% if r.display_title != r.title %}<div style="font-size:11px;color:#999;margin-top:2px;">{{ r.title }}</div>{% endif %}</td>
  <td>{% if r.website %}<a href="{{ r.website }}" target="_blank">🔗</a>{% endif %}</td>
  <td>{{ r.buyer or "" }}</td>
  <td>{{ r.commodity_tier or "" }}</td>
  <td>{{ r.activity_category or "" }}</td>
  <td>{{ r.source }}</td>
  <td>{{ r.date_first_seen }}</td>
  <td class="days">{{ r.days_since }}</td>
  <td>{{ r.deadline or "" }}</td>
  <td>{{ r.reason }}</td>
</tr>
{% endfor %}
</tbody>
</table>
</div>

<script>
const q = document.getElementById('q'), country = document.getElementById('country'),
      category = document.getElementById('category'), source = document.getElementById('source'),
      tier = document.getElementById('tier'), activityCategory = document.getElementById('activityCategory'),
      hideExpired = document.getElementById('hideExpired'), onlyStarred = document.getElementById('onlyStarred');
const STAR_KEY = 'vadMonitorStarred';
function loadStarred() {
  try { return JSON.parse(localStorage.getItem(STAR_KEY) || '{}'); } catch (e) { return {}; }
}
function saveStarred(obj) { localStorage.setItem(STAR_KEY, JSON.stringify(obj)); }
const starred = loadStarred();
document.querySelectorAll('#tbl tbody tr').forEach(row => {
  const id = row.dataset.starId;
  const box = row.querySelector('.star-check');
  if (starred[id]) { box.checked = true; row.classList.add('starred'); }
  box.addEventListener('change', () => {
    if (box.checked) { starred[id] = true; row.classList.add('starred'); }
    else { delete starred[id]; row.classList.remove('starred'); }
    saveStarred(starred);
    applyFilters();
  });
});
function applyFilters() {
  const term = q.value.toLowerCase();
  document.querySelectorAll('#tbl tbody tr').forEach(row => {
    const okText = !term || row.dataset.text.includes(term);
    const okCountry = !country.value || row.dataset.country === country.value;
    const okCategory = !category.value || row.dataset.category === category.value;
    const okSource = !source.value || row.dataset.source === source.value;
    const okTier = !tier.value || row.dataset.tier === tier.value;
    const okActivityCategory = !activityCategory.value || row.dataset.activityCategory === activityCategory.value;
    const okExpired = !hideExpired.checked || row.dataset.expired !== "True";
    const okStarred = !onlyStarred.checked || !!starred[row.dataset.starId];
    row.style.display = (okText && okCountry && okCategory && okSource && okTier && okActivityCategory && okExpired && okStarred) ? "" : "none";
  });
}
[q, country, category, source, tier, activityCategory, hideExpired, onlyStarred].forEach(el => el.addEventListener('input', applyFilters));
document.querySelectorAll('th[data-k]').forEach(th => th.addEventListener('click', () => {
  const key = th.dataset.k;
  const tbody = document.querySelector('#tbl tbody');
  const rows = Array.from(tbody.querySelectorAll('tr'));
  const idx = Array.from(th.parentNode.children).indexOf(th);
  const asc = th.dataset.asc !== "true";
  rows.sort((a, b) => a.children[idx].innerText.localeCompare(b.children[idx].innerText) * (asc ? 1 : -1));
  th.dataset.asc = asc;
  rows.forEach(r => tbody.appendChild(r));
}));
</script>
</body>
</html>
