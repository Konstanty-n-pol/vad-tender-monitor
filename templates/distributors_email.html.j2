<!DOCTYPE html>
<html lang="pl">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"></head>
<body style="margin:0;padding:0;background:#f4f4f5;font-family:-apple-system,Helvetica,Arial,sans-serif;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f4f5;padding:16px 0;">
<tr><td align="center">
<table role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width:600px;width:100%;background:#ffffff;border-radius:8px;overflow:hidden;">

<tr><td style="background:#1a1a2e;padding:20px 24px;">
<h1 style="margin:0;color:#fff;font-size:18px;">Dystrybutorzy/Broker/Reseller (CH) — {{ run_date }}</h1>
<p style="margin:6px 0 0;color:#c0c0d0;font-size:13px;">{{ new_records|length }} nowych firm w tym tygodniu</p>
</td></tr>

{% if not new_records %}
<tr><td style="padding:32px 24px;text-align:center;color:#666;font-size:14px;">
Cisza w tym tygodniu — brak nowych firm powyżej progu istotności.
</td></tr>
{% else %}
<tr><td style="padding:20px 24px 4px;">
{% for r in new_records[:20] %}
<div style="padding:10px 0;border-bottom:1px solid #eee;">
<a href="{{ r.url }}" style="font-size:14px;font-weight:600;color:#1a1a2e;text-decoration:none;">🇨🇭 {{ r.title }}</a>
<div style="font-size:12px;color:#888;margin-top:3px;">{{ r.buyer or "" }}</div>
<div style="font-size:12px;color:#555;margin-top:2px;">{{ r.reason }}</div>
</div>
{% endfor %}
{% if new_records|length > 20 %}
<p style="font-size:13px;color:#666;padding-top:10px;">...i {{ new_records|length - 20 }} więcej — pełna lista w dashboardzie.</p>
{% endif %}
</td></tr>
{% endif %}

<tr><td style="padding:20px 24px;background:#f9f9fb;text-align:center;">
<a href="{{ dashboard_url }}" style="font-size:13px;color:#1a1a2e;">Pełna lista dystrybutorów →</a>
</td></tr>

</table>
</td></tr>
</table>
</body>
</html>
